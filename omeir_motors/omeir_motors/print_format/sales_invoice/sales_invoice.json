 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    /* A4 Landscape Style */\n    @media print {\n        @page {\n            size: A4 landscape;\n            margin: 0.3in;\n        }\n    }\n    \n    .print-format {\n        font-family: 'Helvetica', 'Arial', sans-serif;\n        font-size: 8.5pt; /* Reduced from 9pt */\n        line-height: 1.2; /* Reduced from 1.3 */\n        color: #333;\n        width: 100%;\n    }\n    \n    /* Header */\n    .invoice-header {\n        text-align: center;\n        margin-bottom: 8px; /* Reduced from 15px */\n        border-bottom: 1.5px solid #000;\n        padding-bottom: 4px; /* Reduced from 8px */\n    }\n    \n    .invoice-title {\n        font-size: 20pt; /* Reduced from 22pt */\n        font-weight: bold;\n        color: #000;\n        text-transform: uppercase;\n    }\n    \n    /* Main container tables */\n    table {\n        border-collapse: collapse;\n        width: 100%;\n        margin-bottom: 8px; /* Reduced from 12px */\n    }\n    \n    td, th {\n        padding: 4px; /* Reduced from 6px */\n        vertical-align: top;\n    }\n    \n    .border-all {\n        border: 1.5px solid #000;\n    }\n    \n    .border-all td, .border-all th {\n        border: 1px solid #000;\n    }\n    \n    .no-border {\n        border: none;\n    }\n    \n    .no-border td {\n        border: none;\n    }\n    \n    /* Customer and Invoice details */\n    .info-table {\n        width: 100%;\n        border: 1.5px solid #000;\n        margin-bottom: 8px; /* Reduced from 15px */\n    }\n    \n    .info-table td {\n        border: none;\n        padding: 5px; /* Reduced from 8px */\n    }\n    \n    .info-left {\n        width: 60%;\n        border-right: 1.5px solid #000;\n    }\n    \n    .info-right {\n        width: 40%;\n    }\n    \n    .section-header {\n        font-weight: bold;\n        text-decoration: underline;\n        margin-bottom: 4px; /* Reduced from 8px */\n        font-size: 10pt; /* Reduced from 11pt */\n    }\n    \n    /* Vehicle table */\n    .vehicle-table {\n        width: 100%;\n        border: 1.5px solid #000;\n        border-collapse: collapse;\n    }\n    \n    .vehicle-table th {\n        background-color: #f0f0f0;\n        font-weight: bold;\n        text-transform: uppercase;\n        border: 1px solid #000;\n        padding: 4px; /* Reduced from 6px */\n    }\n    \n    .vehicle-table td {\n        border: 1px solid #000;\n        padding: 4px; /* Reduced from 6px */\n    }\n    \n    /* Work description */\n    .work-description {\n        border: 1.5px solid #000;\n        padding: 5px 8px; /* Reduced from 8px 12px */\n        margin-bottom: 8px; /* Reduced from 15px */\n        font-weight: bold;\n        background-color: #f9f9f9;\n        font-size: 8.5pt;\n    }\n    \n    /* Items table */\n    .items-table {\n        width: 100%;\n        border: 1.5px solid #000;\n        border-collapse: collapse;\n        margin-bottom: 8px; /* Reduced from 15px */\n        font-size: 8pt; /* Reduced from 8.5pt */\n    }\n    \n    .items-table th {\n        background-color: #f0f0f0;\n        font-weight: bold;\n        text-transform: uppercase;\n        border: 1px solid #000;\n        padding: 4px; /* Reduced from 6px */\n        font-size: 7.5pt; /* Smaller font for headers */\n    }\n    \n    .items-table td {\n        border: 1px solid #000;\n        padding: 3px; /* Reduced from 4px */\n    }\n    \n    .labour-header {\n        background-color: #e0e0e0;\n        font-weight: bold;\n    }\n    \n    .labour-header td {\n        padding: 4px; /* Reduced from 6px */\n    }\n    \n    /* Amount words */\n    .amount-words {\n        border: 1.5px solid #000;\n        padding: 5px 8px; /* Reduced from 8px 12px */\n        margin-bottom: 8px; /* Reduced from 15px */\n        font-weight: bold;\n        background-color: #f9f9f9;\n        font-size: 8.5pt;\n    }\n    \n    /* Summary table */\n    .summary-table {\n        width: 42%; /* Slightly reduced from 45% */\n        margin-left: auto;\n        border: 1.5px solid #000;\n        border-collapse: collapse;\n        margin-bottom: 10px; /* Reduced from 20px */\n        font-size: 8.5pt;\n    }\n    \n    .summary-table td {\n        border: 1px solid #000;\n        padding: 4px; /* Reduced from 6px */\n    }\n    \n    .summary-table td:first-child {\n        font-weight: bold;\n        background-color: #f0f0f0;\n    }\n    \n    .summary-table td:last-child {\n        text-align: right;\n    }\n    \n    /* Signatures */\n    .signatures {\n        width: 100%;\n        margin-top: 15px; /* Reduced from 25px */\n    }\n    \n    .signatures table {\n        width: 100%;\n        border: none;\n        margin-bottom: 0;\n    }\n    \n    .signatures td {\n        text-align: center;\n        width: 33.33%;\n        border: none;\n        padding: 0 5px; /* Reduced from 0 10px */\n    }\n    \n    .signature-line {\n        border-top: 1px solid #000;\n        margin-top: 20px; /* Reduced from 35px */\n        padding-top: 5px; /* Reduced from 8px */\n    }\n    \n    .signature-label {\n        font-weight: bold;\n        font-size: 8pt; /* Reduced from 8.5pt */\n        text-transform: uppercase;\n    }\n    \n    /* Helper classes */\n    .text-right {\n        text-align: right;\n    }\n    \n    .bold {\n        font-weight: bold;\n    }\n    \n    .w-100 {\n        width: 100%;\n    }\n</style>\n\n<div class=\"print-format\">\n    \n    <!-- Header -->\n    <div class=\"invoice-header\">\n        <div class=\"invoice-title\">TAX INVOICE</div>\n    </div>\n    \n    {% set job_order = frappe.get_doc(\"Job Order\", doc.custom_job_order) if doc.custom_job_order else None %}\n    {% set vehicle_doc = frappe.get_doc(\"Vehicle\", job_order.vehicle) if job_order and job_order.vehicle else None %}\n    \n    <!-- Customer Information and Invoice Details - Using Table Layout -->\n    <table class=\"info-table\">\n        <tr>\n            <!-- Left side - Customer Information -->\n            <td class=\"info-left\">\n                <div class=\"section-header\">CUSTOMER INFORMATION</div>\n                <div><span class=\"bold\">{{ doc.customer_name or doc.customer }}</span></div>\n                <div>Phone: {{ doc.contact_mobile or doc.contact_phone or 'N/A' }}</div>\n                <div>Email: {{ doc.contact_email or 'N/A' }}</div>\n                <div>Cust. TRN: </div>\n            </td>\n            <!-- Right side - Invoice Details -->\n            <td class=\"info-right\">\n                <div class=\"section-header\">INVOICE DETAILS</div>\n                <table class=\"no-border w-100\">\n                    <tr>\n                        <td class=\"bold\">INVOICE No.</td>\n                        <td>{{ doc.name }}</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bold\">INVOICE DATE</td>\n                        <td>{{ frappe.utils.formatdate(doc.posting_date, \"dd/MM/yyyy\") }}</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bold\">CUSTOMER ID</td>\n                        <td>{{ doc.customer }}</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bold\">JOB CARD No.</td>\n                        <td>{{ doc.custom_job_order or 'N/A' }}</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bold\">L.P.O. No</td>\n                        <td>{{ doc.po_no or doc.custom_lpo_no or 'N/A' }}</td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n    \n    <!-- Vehicle Details Table -->\n    <table class=\"vehicle-table\">\n        <thead>\n            <tr>\n                <th>REG. NO.</th>\n                <th>CHASSIS No.</th>\n                <th>MAKE MODEL</th>\n                <th>KMS</th>\n                <th>VEHICLE IN</th>\n                <th>VEHICLE OUT</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                {% if job_order %}\n                <td>{{ vehicle_doc.license_plate or job_order.vehicle or 'N/A' }}</td>\n                <td>{{ job_order.get('data_toqf') or job_order.chassis_no or 'N/A' }}</td>\n                <td>{{ job_order.make or '' }} {{ job_order.model or '' }} {{ vehicle_doc.year or '' }}</td>\n                <td>{{ job_order.odometer_value_last or '0' }}</td>\n                <td>{{ frappe.utils.formatdate(job_order.in_time, \"dd-MMM-yyyy\") if job_order.in_time else 'N/A' }}</td>\n                <td>{{ frappe.utils.formatdate(job_order.out_time, \"dd-MMM-yyyy\") if job_order.out_time else 'N/A' }}</td>\n                {% else %}\n                <td>{{ doc.custom_vehicle_reg_no or 'N/A' }}</td>\n                <td>{{ doc.custom_chassis_no or 'N/A' }}</td>\n                <td>{{ doc.custom_make_model or 'N/A' }}</td>\n                <td>{{ doc.custom_odometer or '0' }}</td>\n                <td>{{ doc.custom_vehicle_in or 'N/A' }}</td>\n                <td>{{ doc.custom_vehicle_out or 'N/A' }}</td>\n                {% endif %}\n            </tr>\n        </tbody>\n    </table>\n    \n    <!-- Work Description -->\n    <div class=\"work-description\">\n        <span class=\"bold\">WORK DESCRIPTION:</span> {{ job_order.work_description if job_order and job_order.work_description else doc.custom_work_description or 'COST TO CARRY OUT FABRICATION WORKS, CNC MACHINE SHOP WORKS, WELDING WORKS, INCLUDING INSTALLATION OF HEAVY DUTY STRUCTURE SUPPORT' }}\n    </div>\n    \n    <!-- Items Table -->\n    <table class=\"items-table\">\n        <thead>\n            <tr>\n                <th>Description</th>\n                <th>Qty</th>\n                <th>Unit Price</th>\n                <th>Amount</th>\n                <th>Discount</th>\n                <th>Total</th>\n                <th>Vat%</th>\n                <th>Tax Amt</th>\n                <th>Net Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% set ns = namespace(labour_total=0, parts_total=0) %}\n            \n            <!-- First display Parts items -->\n            {% for item in doc.items %}\n                {% set item_group = frappe.db.get_value(\"Item\", item.item_code, \"item_group\") %}\n                \n                <!-- Parts Items (not Labour/Service) -->\n                {% if item_group != 'Labour' and item_group != 'Service' %}\n                    {% set discount_amount = item.discount_amount or 0 %}\n                    {% set total_after_discount = item.amount - discount_amount %}\n                    {% set tax_rate = 5 %}\n                    {% set tax_amount = total_after_discount * (tax_rate / 100) %}\n                    {% set net_amount = total_after_discount + tax_amount %}\n                    {% set ns.parts_total = ns.parts_total + item.amount %}\n                    \n                    <tr>\n                        <td>{{ item.description or item.item_name }}</td>\n                        <td class=\"text-right\">{{ item.qty }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(item.rate, currency=doc.currency) }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(discount_amount, currency=doc.currency) if discount_amount else '-' }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(total_after_discount, currency=doc.currency) }}</td>\n                        <td class=\"text-right\">{{ tax_rate }}%</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(tax_amount, currency=doc.currency) }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(net_amount, currency=doc.currency) }}</td>\n                    </tr>\n                {% endif %}\n            {% endfor %}\n            \n            <!-- Labour Section Header -->\n            <tr class=\"labour-header\">\n                <td colspan=\"9\"><span class=\"bold\">Labour</span></td>\n            </tr>\n            \n            <!-- Then display Labour items -->\n            {% for item in doc.items %}\n                {% set item_group = frappe.db.get_value(\"Item\", item.item_code, \"item_group\") %}\n                \n                <!-- Labour Items -->\n                {% if item_group == 'Labour' or item_group == 'Service' %}\n                    {% set discount_amount = item.discount_amount or 0 %}\n                    {% set total_after_discount = item.amount - discount_amount %}\n                    {% set tax_rate = 5 %}\n                    {% set tax_amount = total_after_discount * (tax_rate / 100) %}\n                    {% set net_amount = total_after_discount + tax_amount %}\n                    {% set ns.labour_total = ns.labour_total + item.amount %}\n                    \n                    <tr>\n                        <td>{{ item.description or item.item_name }}</td>\n                        <td class=\"text-right\">{{ item.qty }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(item.rate, currency=doc.currency) }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(discount_amount, currency=doc.currency) if discount_amount else '-' }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(total_after_discount, currency=doc.currency) }}</td>\n                        <td class=\"text-right\">{{ tax_rate }}%</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(tax_amount, currency=doc.currency) }}</td>\n                        <td class=\"text-right\">{{ frappe.utils.fmt_money(net_amount, currency=doc.currency) }}</td>\n                    </tr>\n                {% endif %}\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <!-- Amount in Words -->\n    <div class=\"amount-words\">\n        <span class=\"bold\">AMOUNT IN WORDS:</span> {{ frappe.utils.money_in_words(doc.grand_total, doc.currency) }}\n    </div>\n    \n    <!-- Summary Table -->\n    <table class=\"summary-table\">\n        <tr>\n            <td>LABOUR</td>\n            <td>{{ frappe.utils.fmt_money(ns.labour_total, currency=doc.currency) }}</td>\n        </tr>\n        <tr>\n            <td>PARTS</td>\n            <td>{{ frappe.utils.fmt_money(ns.parts_total, currency=doc.currency) }}</td>\n        </tr>\n        <tr>\n            <td>TOTAL</td>\n            <td>{{ frappe.utils.fmt_money(doc.total, currency=doc.currency) }}</td>\n        </tr>\n        <tr>\n            <td>DISCOUNT</td>\n            <td>{{ frappe.utils.fmt_money(doc.discount_amount or 0, currency=doc.currency) }}</td>\n        </tr>\n        <tr>\n            <td>SUB TOTAL</td>\n            <td>{{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}</td>\n        </tr>\n        <tr>\n            <td>TAX (5%)</td>\n            <td>{{ frappe.utils.fmt_money(doc.total_taxes_and_charges or 0, currency=doc.currency) }}</td>\n        </tr>\n        <tr style=\"font-weight: bold; background-color: #f0f0f0;\">\n            <td>NET TOTAL</td>\n            <td>{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}</td>\n        </tr>\n    </table>\n    \n    <!-- Signatures -->\n    <div class=\"signatures\">\n        <table>\n            <tr>\n                <td>\n                    <div class=\"signature-line\"></div>\n                    <div class=\"signature-label\">Signature Of Customer</div>\n                </td>\n                <td>\n                    <div class=\"signature-line\"></div>\n                    <div class=\"signature-label\">Signature Of Receptionist</div>\n                </td>\n                <td>\n                    <div class=\"signature-line\"></div>\n                    <div class=\"signature-label\">Authorized Signature</div>\n                </td>\n            </tr>\n        </table>\n    </div>\n</div>",
