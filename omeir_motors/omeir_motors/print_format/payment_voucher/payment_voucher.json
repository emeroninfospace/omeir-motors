 "html": "<div class=\"payment-voucher\">\n  <div class=\"pv-header\">PAYMENT VOUCHER</div>\n\n  <div class=\"pv-body\">\n    <table class=\"pv-top\">\n      <tr>\n        <td class=\"lbl\">AMOUNT (AED):</td>\n        <td class=\"val\">{{ \"{:,.2f}\".format(doc.amount or 0) }}</td>\n        <td class=\"lbl right\">VOUCHER NO:</td>\n        <td class=\"val\">{{ doc.name }}</td>\n      </tr>\n      <tr>\n        <td></td>\n        <td></td>\n        <td class=\"lbl right\">DATE:</td>\n        <td class=\"val\">{{ frappe.utils.formatdate(doc.date) if doc.date else \"\" }}</td>\n      </tr>\n    </table>\n\n    <div class=\"pv-method\">\n      <span class=\"lbl\">Payment Method:</span>\n      <span class=\"opt\">{% if doc.payment_method == \"Cash\" %}\u2611{% else %}\u2610{% endif %} Cash</span>\n      <span class=\"opt\">{% if doc.payment_method == \"A/c Transfer\" %}\u2611{% else %}\u2610{% endif %} A/c Transfer</span>\n      <span class=\"opt\">{% if doc.payment_method == \"Cheque\" %}\u2611{% else %}\u2610{% endif %} Cheque</span>\n    </div>\n\n    <table class=\"pv-fields\">\n      <tr><td class=\"lbl\">Paid to Mr/Ms:</td><td class=\"val\">{{ doc.paid_to or \"\" }}</td></tr>\n      <tr><td class=\"lbl\">The Sum Of:</td><td class=\"val\">{{ doc.sum_of or \"\" }}</td></tr>\n      <tr><td class=\"lbl\">On Settlement of:</td><td class=\"val\">{{ doc.on_settlement_of or \"\" }}</td></tr>\n      <tr><td class=\"lbl\">On:</td><td class=\"val\">{{ frappe.utils.formatdate(doc.on_date) if doc.on_date else \"\" }}</td></tr>\n    </table>\n\n    <div class=\"pv-footer-line\"></div>\n    <table class=\"pv-signatures\">\n      <tr>\n        <td>Paid By<br><span class=\"sig\">{{ doc.paid_by or \"\" }}</span></td>\n        <td>Verified By<br><span class=\"sig\">{{ doc.verified_by or \"\" }}</span></td>\n        <td>Received By<br><span class=\"sig\">{{ doc.received_by or \"\" }}</span></td>\n      </tr>\n    </table>\n  </div>\n</div>\n\n<style>\n  .payment-voucher {\n    font-family: Arial, sans-serif;\n    color: #000;\n    width: 100%;\n    border: 1px solid #ccc;\n  }\n  .pv-header {\n    background: #2c3e50;\n    color: #fff;\n    text-align: center;\n    font-weight: bold;\n    font-size: 18px;\n    padding: 10px;\n    letter-spacing: 1px;\n  }\n  .pv-body { padding: 18px 22px; }\n  .pv-top { width: 100%; border-collapse: collapse; margin-bottom: 14px; }\n  .pv-top td { padding: 6px 4px; vertical-align: bottom; }\n  .pv-top .lbl, .pv-fields .lbl, .pv-method .lbl {\n    font-weight: bold; white-space: nowrap;\n  }\n  .pv-top .right { text-align: right; padding-right: 8px; }\n  .pv-top .val, .pv-fields .val {\n    border-bottom: 1px solid #000;\n    min-width: 150px;\n    padding-bottom: 2px;\n  }\n  .pv-method { margin: 12px 0 16px 0; font-size: 13px; }\n  .pv-method .opt { margin-left: 28px; font-weight: bold; }\n  .pv-fields { width: 100%; border-collapse: collapse; }\n  .pv-fields td { padding: 8px 4px; }\n  .pv-fields .lbl { text-align: right; width: 160px; padding-right: 8px; }\n  .pv-footer-line {\n    border-top: 2px solid #000;\n    margin-top: 22px;\n  }\n  .pv-signatures {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 6px;\n  }\n  .pv-signatures td {\n    width: 33.33%;\n    text-align: center;\n    font-weight: bold;\n    padding: 6px;\n    border-bottom: 1px solid #000;\n  }\n  .pv-signatures .sig { font-weight: normal; display: inline-block; margin-top: 4px; }\n</style>",
