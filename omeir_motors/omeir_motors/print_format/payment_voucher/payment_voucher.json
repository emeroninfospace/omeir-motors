 "html": "<div class=\"letter_head\" style=\"width:100%; margin:0; padding:0;\" id=\"header-html\">\n    {% if letter_head and not no_letterhead -%}\n    <div class=\"letter-head\">{{ letter_head }}</div>\n    {%- endif %}\n</div>\n<div class=\"payment-voucher\">\n  <div class=\"pv-header\">PAYMENT VOUCHER</div>\n  <div class=\"pv-body\">\n\n    <!-- Top: Amount + Voucher No + Date -->\n    <table class=\"pv-top\">\n      <tr>\n        <td class=\"lbl-left\">AMOUNT (AED):</td>\n        <td class=\"val\">{{ \"{:,.2f}\".format(doc.amount or 0) }}</td>\n        <td class=\"lbl-right\">VOUCHER NO:</td>\n        <td class=\"val\">{{ doc.name }}</td>\n      </tr>\n      <tr>\n        <td></td>\n        <td></td>\n        <td class=\"lbl-right\">DATE:</td>\n        <td class=\"val\">{{ frappe.utils.formatdate(doc.date) if doc.date else \"\" }}</td>\n      </tr>\n    </table>\n\n    <!-- Main fields - all values aligned to the same vertical line -->\n    <table class=\"pv-fields\">\n      <tr>\n        <td class=\"lbl\">Payment Method:</td>\n        <td class=\"val no-line\">\n          <span class=\"opt\">{% if doc.payment_method == \"Cash\" %}\u2611{% else %}\u2610{% endif %} Cash</span>\n          <span class=\"opt\">{% if doc.payment_method == \"A/c Transfer\" %}\u2611{% else %}\u2610{% endif %} A/c Transfer</span>\n          <span class=\"opt\">{% if doc.payment_method == \"Cheque\" %}\u2611{% else %}\u2610{% endif %} Cheque</span>\n        </td>\n      </tr>\n      <tr><td class=\"lbl\">Paid to Mr/Ms:</td><td class=\"val\">{{ doc.paid_to or \"\" }}</td></tr>\n      <tr><td class=\"lbl\">The Sum Of:</td><td class=\"val\">{{ doc.sum_of or \"\" }}</td></tr>\n      <tr><td class=\"lbl\">On Settlement of:</td><td class=\"val\">{{ doc.on_settlement_of or \"\" }}</td></tr>\n      <tr><td class=\"lbl\">On:</td><td class=\"val\">{{ frappe.utils.formatdate(doc.on_date) if doc.on_date else \"\" }}</td></tr>\n    </table>\n\n    <!-- Spacer to push the signature block down -->\n    <div class=\"pv-spacer\"></div>\n\n    <div class=\"pv-footer-line\"></div>\n    <table class=\"pv-signatures\">\n      <tr>\n        <td>Paid By<br><span class=\"sig\">{{ doc.paid_by or \"\" }}</span></td>\n        <td>Verified By<br><span class=\"sig\">{{ doc.verified_by or \"\" }}</span></td>\n        <td>Received By<br><span class=\"sig\">{{ doc.received_by or \"\" }}</span></td>\n      </tr>\n    </table>\n\n  </div>\n</div>\n<div id=\"footer-html\" class=\"visible-pdf\" style=\"padding-top: 0px !important;\"> {% if not is_no_need_letterhead and\n\t\tfooter %} <div class=\"letter-head-footer\"> {{ footer }} </div> {% endif %} </div>\n</div>\n\n<style>\n  .payment-voucher {\n    font-family: Arial, sans-serif;\n    color: #000;\n    width: 100%;\n    border: 1px solid #ccc;\n  }\n  .pv-header {\n    background: #2c3e50;\n    color: #fff;\n    text-align: center;\n    font-weight: bold;\n    font-size: 18px;\n    padding: 12px;\n    letter-spacing: 1px;\n  }\n  .pv-body { padding: 26px 30px 30px; }\n\n  /* Top row */\n  .pv-top {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 22px;\n  }\n  .pv-top td {\n    padding: 8px 4px;\n    vertical-align: bottom;\n  }\n  .pv-top .lbl-left {\n    font-weight: bold;\n    white-space: nowrap;\n    width: 130px;\n  }\n  .pv-top .lbl-right {\n    font-weight: bold;\n    white-space: nowrap;\n    text-align: right;\n    padding-right: 8px;\n    width: 110px;\n  }\n  .pv-top .val {\n    border-bottom: 1px solid #000;\n    padding-bottom: 2px;\n  }\n\n  /* Main fields - the key alignment block */\n  .pv-fields {\n    width: 100%;\n    border-collapse: collapse;\n  }\n  .pv-fields td {\n    padding: 14px 4px;          /* more vertical breathing room */\n    vertical-align: bottom;\n  }\n  .pv-fields .lbl {\n    font-weight: bold;\n    white-space: nowrap;\n    text-align: right;\n    width: 170px;               /* fixed label column */\n    padding-right: 12px;\n  }\n  .pv-fields .val {\n    border-bottom: 1px solid #000;\n    padding-bottom: 4px;\n  }\n  .pv-fields .val.no-line {\n    border-bottom: none;        /* Payment Method row has no underline */\n    padding-bottom: 0;\n  }\n  .pv-fields .opt {\n    font-weight: bold;\n    margin-right: 28px;\n  }\n\n  /* Pushes the signature section down for whitespace */\n  .pv-spacer {\n    height: 90px;\n  }\n\n  /* Signatures */\n  .pv-footer-line {\n    border-top: 2px solid #000;\n  }\n  .pv-signatures {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 4px;\n  }\n  .pv-signatures td {\n    width: 33.33%;\n    text-align: center;\n    font-weight: bold;\n    padding: 10px 6px;\n    border-bottom: 1px solid #000;\n  }\n  .pv-signatures .sig {\n    font-weight: normal;\n    display: inline-block;\n    margin-top: 6px;\n    font-size: 13px;\n  }\n</style>",
